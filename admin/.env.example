# Build-time configuration for the Admin Panel (static SPA, ADR 0028).
# Only VITE_-prefixed values reach the browser; none of these are secrets.

# Base URL of the backend API. Default /api is the same-origin path the reverse
# proxy forwards to the backend. The panel's routes live under /api/admin.
VITE_API_BASE_URL=/api

# Timeout for a single API request (milliseconds).
VITE_REQUEST_TIMEOUT_MS=15000

# Dev-server only: where `npm run dev` forwards /api. Not used in the build.
BACKEND_ORIGIN=http://127.0.0.1:8080
