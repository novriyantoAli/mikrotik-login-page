{
  "name": "mikrotik-login-page",
  "version": "1.0.0",
  "private": true,
  "description": "MikroTik hotspot Login Page (KOPINETGO-2024) with voucher purchase flow",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "playwright test",
    "test:app": "playwright test -c playwright.app.config.mjs",
    "test:all": "npm run test && npm run test:smoke && npm run test:app",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
