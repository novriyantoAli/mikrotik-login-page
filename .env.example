# Deployment configuration for the monorepo.
#
# Copy to .env and fill in the secrets. Every key the backend reads appears here:
# `make test` fails if a configuration key in backend/internal/config/config.go
# is not documented in this file. The backend maps `section.key` to
# `SECTION_KEY` (postgres.host -> POSTGRES_HOST), so the names below are exactly
# what docker-compose passes to the api and worker containers.

# TLS is terminated in front of the reverse proxy (see README "TLS"). The proxy
# forwards the original scheme through X-Forwarded-Proto, which the backend uses
# to decide Secure cookies and https:// Magic Links.
#
# --- Application -----------------------------------------------------------
APP_NAME=mikrotik-login-page
# development | production
APP_ENVIRONMENT=production

# --- HTTP API --------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
# Must not exceed 25s: the process lifecycle budget is 30s.
SERVER_SHUTDOWN_TIMEOUT=15s
# CIDRs allowed to set X-Forwarded-For. Empty trusts nobody. The compose proxy
# network is the only hop that should speak for the client.
SERVER_TRUSTED_PROXIES=172.16.0.0/12

# --- Logging ---------------------------------------------------------------
# debug | info | warn | error
LOGGER_LEVEL=info
# json | console
LOGGER_FORMAT=json
# stdout | stderr | a file path
LOGGER_OUTPUT_PATH=stdout

# --- Postgres (application data) -------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=hotspot
POSTGRES_PASSWORD=
POSTGRES_DATABASE=hotspot
POSTGRES_SSL_MODE=disable
# Optional schema pin for tests; leave empty in deployments.
POSTGRES_SEARCH_PATH=
POSTGRES_MAX_OPEN_CONNS=20
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_CONN_MAX_LIFETIME=30m

# --- MySQL FreeRADIUS (hotspot credentials, ADR 0001/0002) -----------------
FREERADIUS_MYSQL_HOST=freeradius-mysql
FREERADIUS_MYSQL_PORT=3306
FREERADIUS_MYSQL_USER=radius
FREERADIUS_MYSQL_PASSWORD=
FREERADIUS_MYSQL_DATABASE=radius
FREERADIUS_MYSQL_MAX_OPEN_CONNS=10
FREERADIUS_MYSQL_MAX_IDLE_CONNS=5
FREERADIUS_MYSQL_CONN_MAX_LIFETIME=30m
# Used only by the MySQL container's first boot, not by the backend.
FREERADIUS_MYSQL_ROOT_PASSWORD=

# --- Redis (background jobs) ----------------------------------------------
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT=5s

# --- Worker ---------------------------------------------------------------
WORKER_CONCURRENCY=10
# Highest priority first, comma separated.
WORKER_QUEUES=critical,default,low

# --- Health endpoint ------------------------------------------------------
HEALTH_TIMEOUT=2s

# --- Compose / images -----------------------------------------------------
# Public port of the single origin (app + /api).
PUBLIC_PORT=8080
BACKEND_TAG=latest
APP_TAG=latest

# --- Test harness (only read by `make test`, never by the deployed stack) --
# Leave unset to start a real embedded Postgres and a local redis-server.
# Set these to reuse service containers (CI does).
TEST_POSTGRES_DSN=host=127.0.0.1 port=5432 user=hotspot password=hotspot dbname=hotspot sslmode=disable
TEST_REDIS_ADDR=127.0.0.1:6379
# Optional: without it the health test asserts the "down" path for FreeRADIUS MySQL.
TEST_FREERADIUS_MYSQL_DSN=radius:radius@tcp(127.0.0.1:3306)/radius
